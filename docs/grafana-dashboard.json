{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "description": "",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "__requires": [
    {
      "type": "grafana",
      "id": "grafana",
      "name": "Grafana",
      "version": "10.0.0"
    },
    {
      "type": "datasource",
      "id": "prometheus",
      "name": "Prometheus",
      "version": "1.0.0"
    }
  ],
  "annotations": {
    "list": []
  },
  "description": "huma RabbitMQ SDK observability dashboard",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 10,
      "title": "Throughput",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": { "unit": "ops", "custom": {} },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 1 },
      "id": 1,
      "options": { "tooltip": { "mode": "multi" } },
      "targets": [
        {
          "expr": "rate(${namespace}_messages_received_total{queue_name=~\"$queue\"}[1m])",
          "legendFormat": "received {{queue_name}}",
          "refId": "A"
        },
        {
          "expr": "rate(${namespace}_messages_acked_total{queue_name=~\"$queue\"}[1m])",
          "legendFormat": "acked {{queue_name}}",
          "refId": "B"
        },
        {
          "expr": "rate(${namespace}_messages_nacked_total{queue_name=~\"$queue\"}[1m])",
          "legendFormat": "nacked {{queue_name}}",
          "refId": "C"
        }
      ],
      "title": "Message rates (per queue)",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": { "unit": "percentunit", "min": 0, "max": 1 },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 1 },
      "id": 2,
      "targets": [
        {
          "expr": "rate(${namespace}_messages_nacked_total{queue_name=~\"$queue\"}[5m]) / (rate(${namespace}_messages_acked_total{queue_name=~\"$queue\"}[5m]) + rate(${namespace}_messages_nacked_total{queue_name=~\"$queue\"}[5m]))",
          "legendFormat": "nack ratio {{queue_name}}",
          "refId": "A"
        }
      ],
      "title": "Nack ratio",
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 9 },
      "id": 11,
      "title": "Publish",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": { "unit": "ops" },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 10 },
      "id": 3,
      "targets": [
        {
          "expr": "rate(${namespace}_publish_success_total{queue_name=~\"$queue\"}[1m])",
          "legendFormat": "success {{queue_name}}",
          "refId": "A"
        },
        {
          "expr": "rate(${namespace}_publish_failed_total{queue_name=~\"$queue\"}[1m])",
          "legendFormat": "failed {{queue_name}}",
          "refId": "B"
        }
      ],
      "title": "Publish rate",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": { "unit": "percentunit", "min": 0, "max": 1 },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 10 },
      "id": 4,
      "targets": [
        {
          "expr": "rate(${namespace}_publish_failed_total{queue_name=~\"$queue\"}[5m]) / (rate(${namespace}_publish_success_total{queue_name=~\"$queue\"}[5m]) + rate(${namespace}_publish_failed_total{queue_name=~\"$queue\"}[5m]))",
          "legendFormat": "failure ratio {{queue_name}}",
          "refId": "A"
        }
      ],
      "title": "Publish failure ratio",
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 18 },
      "id": 12,
      "title": "Processing latency",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": { "unit": "s" },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 19 },
      "id": 5,
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum by (queue_name, le) (rate(${namespace}_message_processing_duration_seconds_bucket{queue_name=~\"$queue\"}[5m])))",
          "legendFormat": "p50 {{queue_name}}",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (queue_name, le) (rate(${namespace}_message_processing_duration_seconds_bucket{queue_name=~\"$queue\"}[5m])))",
          "legendFormat": "p95 {{queue_name}}",
          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.99, sum by (queue_name, le) (rate(${namespace}_message_processing_duration_seconds_bucket{queue_name=~\"$queue\"}[5m])))",
          "legendFormat": "p99 {{queue_name}}",
          "refId": "C"
        }
      ],
      "title": "Processing latency quantiles",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": { "custom": { "scaleDistribution": { "type": "log", "log": 2 } } },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 19 },
      "id": 6,
      "options": { "calculate": false, "yAxis": { "unit": "s" } },
      "targets": [
        {
          "expr": "sum by (le) (rate(${namespace}_message_processing_duration_seconds_bucket{queue_name=~\"$queue\"}[5m]))",
          "format": "heatmap",
          "legendFormat": "{{le}}",
          "refId": "A"
        }
      ],
      "title": "Processing latency heatmap",
      "type": "heatmap"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 27 },
      "id": 13,
      "title": "Connection",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": { "unit": "short" },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 28 },
      "id": 7,
      "targets": [
        {
          "expr": "increase(${namespace}_reconnects_total[5m])",
          "legendFormat": "reconnects (5m window)",
          "refId": "A"
        }
      ],
      "title": "Reconnect events",
      "type": "timeseries"
    }
  ],
  "refresh": "30s",
  "schemaVersion": 38,
  "tags": ["rabbitmq", "huma", "amqp"],
  "templating": {
    "list": [
      {
        "current": {},
        "hide": 0,
        "includeAll": false,
        "label": "Namespace",
        "name": "namespace",
        "options": [],
        "query": "huma",
        "type": "textbox"
      },
      {
        "current": {},
        "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
        "definition": "label_values(${namespace}_messages_received_total, queue_name)",
        "hide": 0,
        "includeAll": true,
        "label": "Queue",
        "multi": true,
        "name": "queue",
        "options": [],
        "query": {
          "query": "label_values(${namespace}_messages_received_total, queue_name)",
          "refId": "StandardVariableQuery"
        },
        "refresh": 2,
        "regex": "",
        "sort": 1,
        "type": "query"
      }
    ]
  },
  "time": { "from": "now-1h", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "huma RabbitMQ SDK",
  "uid": "huma-rabbitmq-sdk",
  "version": 1
}
